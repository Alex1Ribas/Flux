{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "types": ["jest", "node"],
    "target": "esnext",
    "jsx": "react-native",
    "module": "esnext",
    "rootDir": "./",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "customConditions": ["react-native"],
    "allowJs": true,
    "outDir": "./dist",
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "App.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "jest", "e2e", "dist"]
}
