{
  "name": "flux-api",
  "version": "1.0.0",
  "description": "Flux API — Clean Architecture",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/contracts && cp src/contracts/service.yaml dist/contracts/",
    "start": "node dist/main.js",
    "test": "yarn test:unit && yarn test:int",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --forceExit --config ./jest/jest.config.mjs",
    "test:int": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --forceExit --config ./jest/jest.int-config.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-openapi-validator": "^5.5.7",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "ISC"
}
